# Scripts and config that run *inside* Linux containers must keep LF endings.
# Windows checkouts would otherwise convert them and break at runtime
# ("/usr/local/bin/migrate.sh: not found", nginx "$'\r': invalid directive").
*.sh            text eol=lf
*.conf          text eol=lf
Dockerfile      text eol=lf
Dockerfile.*    text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.env*          text eol=lf
