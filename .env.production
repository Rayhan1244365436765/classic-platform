# =============================================================================
# Casino Platform — production environment template
#
# This file is a TEMPLATE, tracked in git, with placeholder values only.
#
# On the server:
#     cp .env.production .env                      # .env is gitignored
#     sed -i 's/__CHANGE_ME__/<strong-password>/g' .env
#     sed -i "s/__CHANGE_ME_JWT__/$(openssl rand -hex 32)/" .env
#     chmod 600 .env
#
# `docker compose -f docker-compose.prod.yml` reads `.env`, and the backend
# receives it through `env_file`. Never commit real secrets.
# =============================================================================

# --- runtime ---------------------------------------------------------------
NODE_ENV=production
PORT=3000

# --- database --------------------------------------------------------------
# The password appears twice on purpose (Postgres init + the connection string).
# Replacing every __CHANGE_ME__ keeps them in sync.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__CHANGE_ME__
POSTGRES_DB=casino

# Host `postgres` is the compose service name — not localhost, which inside the
# API container would point at the container itself.
DATABASE_URL=postgresql://postgres:__CHANGE_ME__@postgres:5432/casino

# --- auth ------------------------------------------------------------------
# Must be at least 32 characters in production, or the API refuses to start.
# Generate with: openssl rand -hex 32
JWT_SECRET=__CHANGE_ME_JWT__

# --- http ------------------------------------------------------------------
# Leave empty when nginx serves the apps and the API on the same origin (the
# default setup). Only set it when a browser on another origin must call the API:
#   CORS_ORIGIN=https://example.com,https://admin.example.com
CORS_ORIGIN=
