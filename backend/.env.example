PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/casino
JWT_SECRET=change-me

# Development-only wallet endpoints (`POST /api/wallet/deposit`, `POST /api/wallet/withdraw`)
# directly credit/debit a wallet. They are DISABLED whenever NODE_ENV=production.
# Set this to "true" only to re-enable them in a production-like environment
# (e.g. automated smoke tests). Defaults to false.
ENABLE_DEV_WALLET_ENDPOINTS=false
